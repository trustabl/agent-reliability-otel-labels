{
  "$comment": "Golden canonicalization. Every language binding must reproduce both the canonical string and the fingerprint exactly. Compare `canonical` first: a character diff says what went wrong, a hash diff does not. See docs/PORTING.md.",
  "algorithm": {
    "serialize": "RFC 8785 (JCS) after volatile keys are stripped: keys sorted by UTF-16 code units, no whitespace, strings and numbers as ECMAScript JSON.stringify writes them, UTF-8 raw, HTML characters unescaped",
    "hash": "sha256 over the UTF-8 bytes, hex, first 16 characters",
    "reject": "a value that cannot be canonicalized yields no fingerprint: integral numbers beyond ±(2^53−1) (floats included), NaN, ±Infinity, non-string keys, non-JSON types"
  },
  "cases": [
    {
      "name": "simple flat object",
      "input": {
        "from": "SFO",
        "to": "JFK",
        "date": "2026-10-01"
      },
      "canonical": "{\"date\":\"2026-10-01\",\"from\":\"SFO\",\"to\":\"JFK\"}",
      "fingerprint": "c1baebf63d8d7587"
    },
    {
      "name": "key order is irrelevant",
      "input": {
        "date": "2026-10-01",
        "to": "JFK",
        "from": "SFO"
      },
      "canonical": "{\"date\":\"2026-10-01\",\"from\":\"SFO\",\"to\":\"JFK\"}",
      "fingerprint": "c1baebf63d8d7587"
    },
    {
      "name": "volatile fields stripped",
      "input": {
        "from": "SFO",
        "to": "JFK",
        "date": "2026-10-01",
        "request_id": "req-abc",
        "timestamp": "2026-09-22T10:00:00Z"
      },
      "canonical": "{\"date\":\"2026-10-01\",\"from\":\"SFO\",\"to\":\"JFK\"}",
      "fingerprint": "c1baebf63d8d7587"
    },
    {
      "name": "nested volatile stripped",
      "input": {
        "outer": {
          "query": "x",
          "trace_id": "deadbeef"
        }
      },
      "canonical": "{\"outer\":{\"query\":\"x\"}}",
      "fingerprint": "00fa1f2d64995abf"
    },
    {
      "name": "volatile inside a list",
      "input": {
        "items": [
          {
            "sku": "A1",
            "nonce": "n1"
          }
        ]
      },
      "canonical": "{\"items\":[{\"sku\":\"A1\"}]}",
      "fingerprint": "5dd8bc3e94bf73ca"
    },
    {
      "name": "meaningful id preserved",
      "input": {
        "customer_id": "c-42"
      },
      "canonical": "{\"customer_id\":\"c-42\"}",
      "fingerprint": "ab4eda6058b55ac8"
    },
    {
      "name": "empty object",
      "input": {},
      "canonical": "{}",
      "fingerprint": "44136fa355b3678a"
    },
    {
      "name": "empty list",
      "input": [],
      "canonical": "[]",
      "fingerprint": "4f53cda18c2baa0c"
    },
    {
      "name": "nulls and booleans",
      "input": {
        "a": null,
        "b": true,
        "c": false
      },
      "canonical": "{\"a\":null,\"b\":true,\"c\":false}",
      "fingerprint": "17073ac6186d8c60"
    },
    {
      "name": "integers stay integral",
      "input": {
        "i": 42,
        "neg": -7
