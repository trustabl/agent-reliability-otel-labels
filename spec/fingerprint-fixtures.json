      "canonical": "{\"s\":\"a\u007fb\"}",
      "fingerprint": "8f8675bc3c1b4364"
    },
    {
      "name": "duplicate keys, last one wins",
      "input": {
        "a": 1,
        "a": 2
      },
      "canonical": "{\"a\":2}",
      "fingerprint": "7e8059f495589fcd"
    }
  ],
  "rejected": {
    "$comment": "Inputs every binding must refuse to canonicalize, so none of them gets a fingerprint. JavaScript cannot tell 1e16 from 10000000000000000, so every binding refuses integral values beyond ±(2^53−1) whether written as an integer or a float. NaN, ±Infinity and non-JSON types cannot be written in JSON; each binding tests those itself.",
    "cases": [
      {
        "name": "integer beyond the safe range",
        "input": {
          "n": 9007199254740992
        }
      },
      {
        "name": "negative integer beyond the safe range",
        "input": {
